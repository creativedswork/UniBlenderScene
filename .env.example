HOST=127.0.0.1
PORT=4312
PUBLIC_BASE_URL=http://127.0.0.1:4312
BLENDER_MCP_HOST=127.0.0.1
BLENDER_MCP_PORT=9877
BLENDER_TIMEOUT_MS=300000
# Set MCP_API_KEY before exposing this service outside localhost.
# Credentials are supplied when connecting; they never belong in mcp.json.
MCP_API_KEY=
# Optional dedicated UI origin for public plugin submission.
WIDGET_DOMAIN=
# Comma-separated approved HTTPS domains for reference file downloads.
FILE_DOWNLOAD_HOSTS=oaiusercontent.com,usercontent.openai.com
# Optional absolute directories for local Codex image attachments, separated
# by the platform path separator (: on macOS/Linux, ; on Windows). Disabled by default.
# LOCAL_REFERENCE_ROOTS=/path/to/workspace/.canova/runs:/path/to/Downloads
# Absolute path shared by the Node server and Blender, if overriding:
# RUNS_ROOT=/srv/codex-blender/.canova/runs
