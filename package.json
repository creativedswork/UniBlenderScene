{
  "name": "codex-blender-plugin",
  "version": "0.1.0",
  "description": "Host-driven Blender scene creation with VIGA feedback and an embedded Three.js viewer.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --import tsx src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:blender": "node --import tsx tests/blender.integration.ts",
    "test:viewer": "node --import tsx tests/viewer.integration.ts",
    "check:scenario-skills": "node scripts/check-scenario-skills.mjs",
    "configure": "tsx scripts/configure.ts",
    "pack:plugin": "tsx scripts/package.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "three": "0.180.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/three": "0.180.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.64.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
