{
  "name": "uni-blender-scene",
  "version": "0.4.3",
  "description": "Blender scene creation and review for Codex, Claude Code, and other agent harnesses, powered by shared Skills and MCP.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsx scripts/build.ts",
    "check": "tsc --noEmit",
    "start": "node --env-file-if-exists=.env --import tsx src/service/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:blender": "node --import tsx tests/blender.integration.ts",
    "test:viewer": "node --import tsx tests/viewer.integration.ts",
    "test:claude": "node --import tsx tests/claude.integration.ts",
    "check:scenario-skills": "node scripts/check-scenario-skills.mjs",
    "configure": "tsx scripts/configure.ts",
    "pack:plugin": "tsx scripts/package.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.26.0",
    "@threert/gameplay": "^0.1.1",
    "@threert/scene": "^0.1.1",
    "esbuild": "^0.25.0",
    "pngjs": "^7.0.0",
    "three": "0.180.0",
    "three-gpu-pathtracer": "^0.0.24",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/pngjs": "^6.0.5",
    "@types/three": "0.180.0",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3"
  }
}
